{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "erasableSyntaxOnly": true,
        "jsx": "preserve",
        "types": ["node"],
        // Lets examples import the package by name, as applications do.
        "paths": {
            "@ayaexptech/presen-it": ["./mod.ts"],
            "@ayaexptech/presen-it/decks": ["./decks.ts"]
        }
    },
    "include": ["mod.ts", "decks.ts", "src", "tests", "vitest.config.ts", "examples/**/*.ts"]
}
