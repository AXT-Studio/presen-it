{
    "name": "@ayaexptech/presen-it",
    "version": "2.0.0-rc.1",
    "description": "A Vite plugin for Markdown presentations, presenter view, and browser PDF export.",
    "keywords": [
        "markdown",
        "marp",
        "pdf",
        "presenit",
        "presentation",
        "slides",
        "slidev"
    ],
    "homepage": "https://github.com/AXT-Studio/presen-it#readme",
    "bugs": {
        "url": "https://github.com/AXT-Studio/presen-it/issues"
    },
    "license": "MIT",
    "author": "AyaExpTech (@AyaExpTech)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AXT-Studio/presen-it.git"
    },
    "files": [
        "dist",
        "README.md",
        "llms.txt",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/mod.d.ts",
            "import": "./dist/mod.js"
        },
        "./decks": {
            "types": "./dist/decks.d.ts",
            "import": "./dist/decks.js"
        }
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "dev": "vite examples/slides",
        "build:example": "vite build examples/slides",
        "preview": "vite preview examples/slides",
        "format": "oxfmt src tests scripts mod.ts decks.ts examples",
        "format:check": "oxfmt --check src tests scripts mod.ts decks.ts examples",
        "lint": "oxlint src tests scripts mod.ts decks.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
        "check:jsr": "deno publish --dry-run --allow-dirty"
    },
    "dependencies": {
        "beautiful-mermaid": "^1.1.3",
        "hast-util-to-html": "^9.0.5",
        "katex": "0.18.1",
        "mdast-util-to-hast": "^13.2.1",
        "mdast-util-to-string": "^4.0.0",
        "parse5": "^8.0.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "shiki": "^4.3.1",
        "tinyglobby": "^0.2.15",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/hast": "^3.0.5",
        "@types/katex": "^0.16.8",
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.0.0",
        "@types/unist": "^3.0.3",
        "esbuild": "^0.27.7",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.0.0",
        "puppeteer-core": "^25.4.0",
        "tsx": "^4.20.0",
        "typescript": "^5.8.0",
        "vite": "8.1.5",
        "vite-plus": "^1.6.0",
        "vitest": "^3.2.0"
    },
    "peerDependencies": {
        "vite": "^8.0.0"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "packageManager": "pnpm@11.11.0"
}
